# Lane Guard CI — FD-102 (branch protection), FD-086 (actor-gate), FD-123 (guard extension)
# This workflow runs on every PR to main and enforces lane ownership rules.
#
# NOTE ON DUPLICATION (do not "fix" by deleting): the `lane-guard` job below
# re-implements a subset of reusable-ci.yml's `validate` job (actor gate,
# schema validation, concordance check) inline instead of delegating to it
# via `uses: ./.github/workflows/reusable-ci.yml`. This is intentional, not
# an oversight. lanes/L0-02-lane-guard.md records it as a binding contract:
# "The check context name is exactly `lane-guard` and never changes ...
# a renamed context leaves branch protection referring to a context nothing
# emits." Calling reusable-ci.yml here would report the check under a
# compound name (GitHub renders reusable-workflow-call jobs as
# "<calling job> / <called job>"), which breaks the CP-1/CP-2 branch-
# protection rulesets in master/02-branch-merge-model.md §10.1/§10.3 that
# require the literal context `lane-guard`.
# Because full delegation is unsafe, the fix for the recurring script-path
# bug (and any future change to these three steps) must be applied in BOTH
# places: this job's "Actor gate" / "Validate schemas" / "Concordance check"
# steps, and reusable-ci.yml's "Actor gate" / "Validate registry schemas" /
# "Run concordance check" steps in its `validate` job.
name: lane-guard

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  pull-requests: read

jobs:
  lane-guard:
    name: lane-guard
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0

      - name: Actor gate
        run: bash scripts/actor-gate.sh
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_ACTOR: ${{ github.actor }}

      - name: Branch path ownership check
        run: |
          set -euo pipefail
          HEAD_REF="${{ github.head_ref || github.ref_name }}"
          echo "Evaluating branch-path ownership for ref: $HEAD_REF"
          case "$HEAD_REF" in
            lane/1/*)
              ALLOW_REGEX='^(schemas/registry/|schemas/product/|registries/|validators/registry/)'
              LANE="1"
              ;;
            lane/2/*)
              ALLOW_REGEX='^(\.github/workflows/|templates/workflows/|tools/evidence/)'
              LANE="2"
              ;;
            lane/3/*)
              ALLOW_REGEX='^(reconciler/|tools/provision/|validators/drift/)'
              LANE="3"
              ;;
            lane/4/*)
              ALLOW_REGEX='^(schemas/records/|metrics/|tools/records/)'
              LANE="4"
              ;;
            lane/5/*)
              ALLOW_REGEX='^(access/|infra/|ops-vm/|notify/|assets/)'
              LANE="5"
              ;;
            l0/*|integration|main)
              echo "Branch $HEAD_REF is an L0 / integration branch: exempt from lane path partition."
              exit 0
              ;;
            *)
              echo "Branch $HEAD_REF does not match lane/[1-5]/* prefix; skipping lane partition check."
              exit 0
              ;;
          esac

          BASE_SHA="${{ github.event.pull_request.base.sha || '' }}"
          HEAD_SHA="${{ github.event.pull_request.head.sha || '' }}"
          if [ -n "$BASE_SHA" ] && [ -n "$HEAD_SHA" ]; then
            CHANGED="$(git diff --name-only "$BASE_SHA...$HEAD_SHA" 2>/dev/null || git diff --name-only "$BASE_SHA..$HEAD_SHA" 2>/dev/null || true)"
          else
            CHANGED="$(git diff --name-only origin/main...HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD 2>/dev/null || true)"
          fi

          if [ -z "$CHANGED" ]; then
            echo "No files changed."
            exit 0
          fi

          VIOLATIONS=0
          while IFS= read -r file; do
            [ -z "$file" ] && continue
            if ! echo "$file" | grep -qE "$ALLOW_REGEX"; then
              echo "LANE-GUARD VIOLATION: Lane $LANE ($HEAD_REF) touched foreign path: $file"
              VIOLATIONS=$((VIOLATIONS + 1))
            fi
          done <<< "$CHANGED"

          if [ "$VIOLATIONS" -gt 0 ]; then
            echo "LANE-GUARD FAIL: $VIOLATIONS foreign path violation(s). PARTITION.md rule 1: one owner per path."
            exit 1
          fi
          echo "LANE-GUARD PASS: All files modified by $HEAD_REF belong to Lane $LANE."

      - name: Validate schemas
        run: |
          python -m validators.registry.cli \
            --root registries/ \
            --as-of $(date +%Y-%m-%d) \
            --records-root records/ \
            --format json

      - name: Concordance check
        run: bash _concordance-check.sh lanes

      - name: Workflow lint — pinning, permissions, no-if
        run: |
          set -euo pipefail
          for dir in .github/workflows templates/workflows; do
            python -m tools.evidence.lint_workflow --path "$dir" --summary
          done

      - name: Required-context cross-check
        run: |
          set -euo pipefail
          python -m tools.evidence.check_required_contexts \
            --templates templates/workflows \
            --registry templates/workflows/required-checks.yaml \
            --summary
