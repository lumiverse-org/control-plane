#!/usr/bin/env python3
"""tools/provision/check-permission — §99.6: Verify repository collaborator permission (CP-0206).

Checks that an assigned collaborator holds expected repository permissions (e.g. Write for cross-reviewer).
A Read-only cross-reviewer fails loudly to prevent silent review bypass (§99.6).
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys

_PERMISSION_LEVELS = {
    "none": 0,
    "read": 1,
    "triage": 2,
    "write": 3,
    "maintain": 4,
    "admin": 5,
}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="check-permission",
        description="Verify repository collaborator permission levels (CP-0206, §99.6).",
    )
    parser.add_argument("--repo", required=True, help="repository in org/repo format")
    parser.add_argument("--login", required=True, help="GitHub user login to check")
    parser.add_argument(
        "--expect",
        required=True,
        choices=("admin", "write", "read"),
        help="minimum expected permission level ('admin', 'write', or 'read')",
    )
    parser.add_argument(
        "--mock-permission",
        default=None,
        help="mock permission level for offline testing (e.g. 'write', 'admin', 'read', 'none')",
    )
    return parser


def _fetch_permission(repo: str, login: str) -> str:
    cmd = ["gh", "api", f"repos/{repo}/collaborators/{login}/permission"]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip()
        if "404" in err or "Not Found" in err:
            return "none"
        raise RuntimeError(f"error querying collaborator permission: {err or proc.stdout.strip()}")

    try:
        data = json.loads(proc.stdout)
        return str(data.get("permission", "none")).lower()
    except Exception as exc:
        raise ValueError(f"failed to parse GitHub API permission response: {exc}") from exc


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    repo = args.repo.strip()
    login = args.login.strip()
    expected = args.expect.lower()

    try:
        if args.mock_permission is not None:
            actual = args.mock_permission.lower()
        else:
            actual = _fetch_permission(repo, login)
    except Exception as exc:
        print(f"CHECK-PERMISSION FAIL: {exc}", file=sys.stderr)
        return 1

    expected_level = _PERMISSION_LEVELS.get(expected, 3)
    actual_level = _PERMISSION_LEVELS.get(actual, 0)

    if actual_level >= expected_level and actual_level > 0:
        print(
            f"CHECK-PERMISSION PASS: user '{login}' holds '{actual}' permission on '{repo}' "
            f"(satisfies minimum '{expected}')."
        )
        return 0

    print(
        f"CHECK-PERMISSION FAIL: user '{login}' holds '{actual}' permission on '{repo}'; "
        f"requires minimum '{expected}' (Section 99.6: cross-reviewer must hold write, not read/none).",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
