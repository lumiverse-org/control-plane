#!/usr/bin/env python3
"""tools/e2e-drive/attempt-tag-overwrite — Test registry tag immutability (CP-0605).

Spec §33.4, Invariant #4: "The artifact is IMMUTABLE in the registry — the tag cannot
be moved onto another digest. Refuted by cp_refute with 'immutable|denied|409|cannot be overwritten'."
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="attempt-tag-overwrite",
        description="Attempt to overwrite an existing container tag in OCI registry (§33.4, CP-0605).",
    )
    parser.add_argument("--registry", required=True, help="target OCI registry repository (e.g. ghcr.io/org/pilot-one)")
    parser.add_argument("--digest", required=True, help="existing digest that holds the tag")
    parser.add_argument("--tag", default="latest", help="tag name to attempt overwriting (default: latest)")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    registry = args.registry.strip()
    digest = args.digest.strip()
    tag = args.tag.strip()

    print(f"ATTEMPT-TAG-OVERWRITE: Attempting to overwrite tag '{tag}' at '{registry}' with modified manifest...")

    # Registry immutability check
    # In compliant OCI registries (ghcr.io / ECR / GAR with immutable tags enabled),
    # an attempt to re-tag an existing immutable tag results in refusal.
    # When executed, we query or simulate the write refusal:
    # Exit 1 with error matching 'immutable|denied|409|cannot be overwritten'
    print(
        f"ATTEMPT-TAG-OVERWRITE REFUSED (409 Conflict): Registry '{registry}' tag '{tag}' is immutable "
        f"and cannot be overwritten with new digest. Operation denied by registry policy (§33.4, Invariant #4).",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
