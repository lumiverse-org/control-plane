#!/usr/bin/env python3
"""tools/e2e-drive/run-workflow — Dispatch workflow and assert conclusion (CP-0701, CP-0703).

Spec §33.2, §33.4: "Dispatches workflow with parameters, waits for completion,
and asserts expected conclusion."
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path


def _run_gh(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(f"gh command failed: {' '.join(cmd)}\n{err}")
    return proc


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="run-workflow",
        description="Dispatch GitHub Actions workflow and wait for expected conclusion (§33.4, CP-0701, CP-0703).",
    )
    parser.add_argument("--repo", required=True, help="target repository (e.g. lumiverse-org/pilot-one-api)")
    parser.add_argument("--workflow", required=True, help="workflow file name (e.g. migrate.yml, deploy-staging.yml)")
    parser.add_argument("--expect", default="success", help="expected conclusion (default: success)")
    parser.add_argument("--ref", default="main", help="git ref / branch to dispatch on (default: main)")
    parser.add_argument("--timeout", type=int, default=180, help="maximum wait time in seconds (default: 180)")
    parser.add_argument("--poll-interval", type=int, default=5, help="poll interval in seconds (default: 5)")
    return parser


def main(argv: list[str] | None = None) -> int:
    # Separate known args from arbitrary workflow inputs
    parser = build_parser()
    args, unknown = parser.parse_known_args(argv)

    repo = args.repo.strip()
    workflow = args.workflow.strip()
    expect = args.expect.lower().strip()
    ref = args.ref.strip()

    # Parse extra workflow inputs (--key value or --key=value)
    inputs: dict[str, str] = {}
    i = 0
    while i < len(unknown):
        arg = unknown[i]
        if arg.startswith("--"):
            key = arg[2:]
            val = ""
            if "=" in key:
                key, val = key.split("=", 1)
            elif i + 1 < len(unknown) and not unknown[i + 1].startswith("--"):
                i += 1
                val = unknown[i]
            inputs[key] = val
        i += 1

    print(f"RUN-WORKFLOW: Dispatching '{workflow}' on {repo} (ref: {ref}, inputs: {inputs})...")

    # 1. Capture existing runs before dispatch to distinguish new run
    existing_run_ids: set[int] = set()
    try:
        list_cmd = ["gh", "run", "list", "--repo", repo, "--workflow", workflow, "--limit", "10", "--json", "databaseId"]
        res = _run_gh(list_cmd)
        existing_run_ids = {r["databaseId"] for r in json.loads(res.stdout)}
    except Exception as exc:
        print(f"  ... warning: failed to list existing runs: {exc}", file=sys.stderr)

    # 2. Dispatch workflow
    dispatch_cmd = ["gh", "workflow", "run", workflow, "--repo", repo, "--ref", ref]
    for k, v in inputs.items():
        dispatch_cmd.extend(["-f", f"{k}={v}"])

    try:
        _run_gh(dispatch_cmd)
        print(f"RUN-WORKFLOW: Dispatched workflow '{workflow}' successfully.")
    except Exception as exc:
        print(f"RUN-WORKFLOW FAIL: Failed to dispatch workflow '{workflow}': {exc}", file=sys.stderr)
        return 1

    # 3. Poll for the newly created run
    print(f"RUN-WORKFLOW: Waiting for new run of '{workflow}' to appear...")
    start_time = time.time()
    new_run_id: int | None = None

    while time.time() - start_time < 30:
        time.sleep(args.poll_interval)
        try:
            list_cmd = ["gh", "run", "list", "--repo", repo, "--workflow", workflow, "--limit", "5", "--json", "databaseId,status,conclusion,url"]
            res = _run_gh(list_cmd)
            runs = json.loads(res.stdout)
            for r in runs:
                if r["databaseId"] not in existing_run_ids:
                    new_run_id = r["databaseId"]
                    print(f"RUN-WORKFLOW: Detected new run #{new_run_id} ({r.get('url')}).")
                    break
            if new_run_id:
                break
        except Exception:
            pass

    if not new_run_id:
        print(f"RUN-WORKFLOW FAIL: Timed out waiting for new run of '{workflow}' to appear on {repo}", file=sys.stderr)
        return 1

    # 4. Wait for the run to complete and assert expected conclusion
    print(f"RUN-WORKFLOW: Monitoring run #{new_run_id} until completed (expecting '{expect}')...")
    while time.time() - start_time < args.timeout:
        try:
            view_cmd = ["gh", "run", "view", str(new_run_id), "--repo", repo, "--json", "status,conclusion,url"]
            res = _run_gh(view_cmd)
            run_data = json.loads(res.stdout)
            status = (run_data.get("status") or "").lower()
            conclusion = (run_data.get("conclusion") or "").lower()

            if status == "completed":
                if conclusion == expect:
                    print(f"RUN-WORKFLOW PASS: Run #{new_run_id} concluded with expected '{conclusion}' ({run_data.get('url')}).")
                    return 0
                else:
                    print(
                        f"RUN-WORKFLOW FAIL: Run #{new_run_id} concluded with unexpected '{conclusion}' (expected '{expect}'): {run_data.get('url')}",
                        file=sys.stderr,
                    )
                    return 1
            else:
                print(f"  ... run #{new_run_id} status='{status}'", flush=True)
        except Exception as exc:
            print(f"  ... query error: {exc}", flush=True)

        time.sleep(args.poll_interval)

    print(f"RUN-WORKFLOW FAIL: Timed out waiting for run #{new_run_id} to complete after {args.timeout}s", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
