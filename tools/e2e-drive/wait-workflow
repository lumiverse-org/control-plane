#!/usr/bin/env python3
"""tools/e2e-drive/wait-workflow — Wait for workflow execution and check conclusion (CP-0601).

Spec §33.2: "Build workflow produced an artifact — waits for workflow run on target
commit and asserts successful conclusion."
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent.parent


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="wait-workflow",
        description="Wait for workflow run completion on a commit SHA (§33.2, CP-0601).",
    )
    parser.add_argument("--repo", required=True, help="repository (e.g. lumiverse-org/pilot-one-api)")
    parser.add_argument("--workflow", required=True, help="workflow file name (e.g. build.yml)")
    parser.add_argument("--sha", required=True, help="commit SHA to check")
    parser.add_argument("--expect", default="success", help="expected conclusion (default: success)")
    parser.add_argument("--timeout", type=int, default=180, help="maximum wait time in seconds (default: 180)")
    parser.add_argument("--poll-interval", type=int, default=10, help="polling interval in seconds (default: 10)")
    return parser


def _run_gh(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(f"gh command failed: {' '.join(cmd)}\n{err}")
    return proc


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    repo = args.repo.strip()
    workflow = args.workflow.strip()
    sha = args.sha.strip()
    expect = args.expect.lower().strip()

    print(f"WAIT-WORKFLOW: Waiting for workflow '{workflow}' on {repo}@{sha[:8]} (expecting '{expect}')...")

    start_time = time.time()
    last_run: dict | None = None

    while time.time() - start_time < args.timeout:
        cmd = [
            "gh",
            "run",
            "list",
            "--repo",
            repo,
            "--workflow",
            workflow,
            "--commit",
            sha,
            "--json",
            "databaseId,name,status,conclusion,headSha,url",
        ]
        try:
            res = _run_gh(cmd)
            runs = json.loads(res.stdout)
            if runs:
                last_run = runs[0]
                status = (last_run.get("status") or "").lower()
                conclusion = (last_run.get("conclusion") or "").lower()

                if status == "completed":
                    if conclusion == expect:
                        print(
                            f"WAIT-WORKFLOW PASS: Workflow '{workflow}' run #{last_run.get('databaseId')} "
                            f"completed with expected conclusion '{conclusion}' ({last_run.get('url')})."
                        )
                        return 0
                    else:
                        print(
                            f"WAIT-WORKFLOW FAIL: Workflow '{workflow}' completed with unexpected conclusion "
                            f"'{conclusion}' (expected '{expect}'): {last_run.get('url')}",
                            file=sys.stderr,
                        )
                        return 1
                else:
                    print(f"  ... run #{last_run.get('databaseId')} in state: status='{status}'", flush=True)
            else:
                print(f"  ... no workflow run found yet for {sha[:8]}", flush=True)
        except Exception as exc:
            print(f"  ... query error: {exc}", flush=True)

        time.sleep(args.poll_interval)

    if last_run:
        print(
            f"WAIT-WORKFLOW FAIL: Timed out after {args.timeout}s waiting for {workflow} to complete. "
            f"Last status: {last_run.get('status')}, conclusion: {last_run.get('conclusion')} ({last_run.get('url')})",
            file=sys.stderr,
        )
    else:
        print(
            f"WAIT-WORKFLOW FAIL: Timed out after {args.timeout}s: no runs triggered for {workflow} on commit {sha}",
            file=sys.stderr,
        )
    return 1


if __name__ == "__main__":
    sys.exit(main())
