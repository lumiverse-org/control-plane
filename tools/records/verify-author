#!/usr/bin/env python3
"""tools/records/verify-author — Verify commit author of record files (CP-0709).

Spec §97.1, D89: "The UAT record was written by the records-writer credential into
the records repository — not by a human, not into the control plane."
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path


def _run_gh(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(f"gh command failed: {' '.join(cmd)}\n{err}")
    return proc


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="verify-author",
        description="Verify author of a record commit in records repository (§97.1, CP-0709).",
    )
    parser.add_argument("--repo", required=True, help="records repository (e.g. lumiverse-org/control-plane-records)")
    parser.add_argument("--path", required=True, help="path to record file within repository")
    parser.add_argument("--expect-author", default="records-writer[bot]", help="expected commit author (default: records-writer[bot])")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    repo = args.repo.strip()
    path = args.path.strip()
    expect_author = args.expect_author.strip()

    print(f"VERIFY-AUTHOR: Querying commit provenance for '{path}' on repository '{repo}'...")

    if not path:
        print("VERIFY-AUTHOR FAIL: Empty record path specified.", file=sys.stderr)
        return 1

    cmd = ["gh", "api", f"repos/{repo}/commits?path={path}&per_page=1"]
    try:
        res = _run_gh(cmd)
        commits = json.loads(res.stdout)
        if not commits:
            print(f"VERIFY-AUTHOR FAIL: No commits found for path '{path}' on {repo}.", file=sys.stderr)
            return 1

        first_commit = commits[0]
        commit_obj = first_commit.get("commit") or {}
        author_login = (first_commit.get("author") or {}).get("login", "")
        committer_login = (first_commit.get("committer") or {}).get("login", "")
        commit_author_name = (commit_obj.get("author") or {}).get("name", "")

        actual_author = author_login or committer_login or commit_author_name
        if actual_author == expect_author or expect_author in (author_login, committer_login, commit_author_name):
            print(f"VERIFY-AUTHOR PASS: Record at '{path}' authored by expected identity '{expect_author}'.")
            return 0
        else:
            print(
                f"VERIFY-AUTHOR FAIL: Record author mismatch for '{path}': actual='{actual_author}', expected='{expect_author}'",
                file=sys.stderr,
            )
            return 1
    except Exception as exc:
        print(f"VERIFY-AUTHOR FAIL: Failed to query commit history for '{path}' on {repo}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
