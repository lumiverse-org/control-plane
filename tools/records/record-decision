#!/usr/bin/env bash
# tools/records/record-decision — Decision CLI wrapper. Delegates to record_decision.py per FD-131.
# Usage: record-decision pending --product <prod> --decider <id> --subject <text>
#        record-decision decide --id <DEC-ID> --options <opt1> --evidence <ev1>
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${L4_PY:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
  PY="python"
fi
exec "$PY" "$HERE/record_decision.py" "$@"
