# Usage: record-verification-result <product> <item> <mechanism> <pass|fail> <evidence_link> <actor>
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${L4_PY:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
