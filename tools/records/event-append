#!/usr/bin/env bash
# tools/records/event-append — L2-facing front-end. Delegates to event_append.py per FD-131.
# Usage: event-append <event_type> <actor> <product> <subject_ref> [payload-file]
#    or: event-append --event-type <type> --actor <actor> --product <product> --subject-ref <ref> [--payload <file>]
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${L4_PY:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
  PY="python"
fi
exec "$PY" "$HERE/event_append.py" "$@"
