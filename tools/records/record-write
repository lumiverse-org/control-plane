#!/usr/bin/env bash
# tools/records/record-write — L2-facing front-end. Delegates to record_write.py per FD-131.
# Usage: record-write <store> <id> <body-file> [schema-file]
#    or: record-write --store <store> --id <id> --from-file <file> [--schema <schema>] [--validate-only]
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="${L4_PY:-python3}"
if ! command -v "$PY" >/dev/null 2>&1; then
  PY="python"
fi
exec "$PY" "$HERE/record_write.py" "$@"
