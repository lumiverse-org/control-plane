#!/usr/bin/env python3
"""tools/evidence/read-digest — Read recorded artifact digest from build run (CP-0602).

Spec §33.4: "The digest. Everything downstream is this string. Outputs sha256:<64-hex>."
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DIGEST_RE = re.compile(r"sha256:[0-9a-fA-F]{64}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="read-digest",
        description="Read recorded artifact digest from build workflow run (§33.4, CP-0602).",
    )
    parser.add_argument("--repo", required=True, help="repository (e.g. lumiverse-org/pilot-one-api)")
    parser.add_argument("--sha", required=True, help="commit SHA corresponding to the build")
    return parser


def _run_gh(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(f"gh command failed: {' '.join(cmd)}\n{err}")
    return proc


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    repo = args.repo.strip()
    sha = args.sha.strip()

    # 1. Query workflow runs for this commit
    cmd = [
        "gh",
        "run",
        "list",
        "--repo",
        repo,
        "--commit",
        sha,
        "--json",
        "databaseId,name,status,conclusion",
    ]
    try:
        res = _run_gh(cmd)
        runs = json.loads(res.stdout)
    except Exception as exc:
        print(f"READ-DIGEST FAIL: failed to query workflow runs on {repo}: {exc}", file=sys.stderr)
        return 1

    if not runs:
        print(f"READ-DIGEST FAIL: no workflow runs found for commit {sha} on {repo}", file=sys.stderr)
        return 1

    # 2. Check each run log for sha256 digest
    for run in runs:
        run_id = run["databaseId"]
        log_cmd = ["gh", "run", "view", str(run_id), "--repo", repo, "--log"]
        try:
            log_res = _run_gh(log_cmd)
            match = DIGEST_RE.search(log_res.stdout)
            if match:
                digest = match.group(0).lower()
                print(digest)
                return 0
        except Exception:
            continue

    # 3. Check commit check-runs output
    checks_cmd = ["gh", "api", f"repos/{repo}/commits/{sha}/check-runs"]
    try:
        checks_res = _run_gh(checks_cmd)
        checks_data = json.loads(checks_res.stdout)
        for cr in checks_data.get("check_runs", []):
            text_corpus = f"{cr.get('output', {}).get('title', '')} {cr.get('output', {}).get('summary', '')} {cr.get('output', {}).get('text', '')}"
            match = DIGEST_RE.search(text_corpus)
            if match:
                digest = match.group(0).lower()
                print(digest)
                return 0
    except Exception:
        pass

    print(
        f"READ-DIGEST FAIL: no recorded sha256 digest found in build runs or check-runs for {repo}@{sha[:8]}",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
