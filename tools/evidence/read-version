#!/usr/bin/env python3
"""tools/evidence/read-version — Read artifact digest from running service /version endpoint (CP-0704, CP-0907).

Spec §41.2, §33.4: "Queries service GET /version and extracts the deployed artifact_digest.
Outputs sha256:<64-hex>."
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request
import urllib.error


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="read-version",
        description="Query service /version endpoint for deployed artifact digest (§41.2, CP-0704, CP-0907).",
    )
    parser.add_argument("--env", default="staging", help="environment to query (default: staging)")
    parser.add_argument("--product", required=True, help="product slug (e.g. pilot-one)")
    parser.add_argument("--url", default=None, help="override endpoint URL (default: resolved from env convention)")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    env = args.env.strip().lower()
    product = args.product.strip()

    # Determine endpoint URL
    if args.url:
        target_url = args.url.strip()
    else:
        # Standard estate internal routing conventions
        port = 8080 if product in ("pilot-one", "Product-1") else 8081
        target_url = os.environ.get("SERVICE_VERSION_URL", f"http://localhost:{port}/version")

    try:
        req = urllib.request.Request(target_url, headers={"User-Agent": "read-version/1.0", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            digest = data.get("artifact_digest") or data.get("digest") or data.get("version")
            if not digest:
                print(f"READ-VERSION FAIL: /version response missing 'artifact_digest' field: {data}", file=sys.stderr)
                return 1
            print(str(digest).strip())
            return 0
    except Exception as exc:
        print(f"READ-VERSION FAIL: Failed to query /version at {target_url} ({env}/{product}): {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
