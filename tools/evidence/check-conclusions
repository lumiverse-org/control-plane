#!/usr/bin/env python3
"""tools/evidence/check-conclusions — Verify required status checks report real conclusions (CP-0502).

Spec §33.2: "Every required status check reports a REAL conclusion. A skipped or
neutral conclusion on a required context is Blocking drift — a skip that branch
protection counts as satisfied is a check that can only pass."
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parent.parent.parent


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="check-conclusions",
        description="Verify PR status checks report non-skipped, non-neutral conclusions (§33.2, CP-0502).",
    )
    parser.add_argument("--pr", required=True, help="pull request number or url")
    parser.add_argument("--repo", default=None, help="repository (defaults to E2E_REPO or lumiverse-org/pilot-one-api)")
    parser.add_argument(
        "--required-from",
        type=Path,
        default=None,
        help="JSON file containing required branch protection contexts (e.g. templates/protection/service.json)",
    )
    parser.add_argument(
        "--forbid",
        default="skipped,neutral",
        help="comma-separated list of forbidden conclusions (default: skipped,neutral)",
    )
    return parser


def _run_gh(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise RuntimeError(f"gh command failed: {' '.join(cmd)}\n{err}")
    return proc


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    repo = args.repo or os.environ.get("E2E_REPO", "lumiverse-org/pilot-one-api")
    pr = args.pr.strip()
    forbidden = {c.strip().upper() for c in args.forbid.split(",") if c.strip()}

    required_contexts: set[str] = set()
    if args.required_from:
        req_file = args.required_from.resolve()
        if req_file.is_file():
            try:
                data = json.loads(req_file.read_text(encoding="utf-8"))
                for ctx in data.get("required_status_checks", {}).get("contexts", []):
                    required_contexts.add(ctx.strip())
            except Exception as exc:
                print(f"CHECK-CONCLUSIONS FAIL: failed to read required contexts from {req_file}: {exc}", file=sys.stderr)
                return 1

    # Fetch statusCheckRollup for the PR
    cmd = [
        "gh",
        "pr",
        "view",
        pr,
        "--repo",
        repo,
        "--json",
        "number,headRefOid,statusCheckRollup",
    ]
    try:
        res = _run_gh(cmd)
        pr_data = json.loads(res.stdout)
    except Exception as exc:
        print(f"CHECK-CONCLUSIONS FAIL: failed to inspect PR #{pr} on '{repo}': {exc}", file=sys.stderr)
        return 1

    rollup = pr_data.get("statusCheckRollup") or []
    if not rollup:
        print(f"CHECK-CONCLUSIONS FAIL: zero status checks or workflow runs recorded for PR #{pr} on '{repo}'.", file=sys.stderr)
        return 1

    violations: list[str] = []
    checked_count = 0
    in_progress: list[str] = []

    for item in rollup:
        # Item can be CheckRun or StatusContext
        name = item.get("name") or item.get("context") or "unknown"
        status = (item.get("status") or item.get("state") or "").upper()
        conclusion = (item.get("conclusion") or "").upper()

        checked_count += 1
        if status in ("IN_PROGRESS", "QUEUED", "PENDING"):
            in_progress.append(f"{name} ({status})")

        if conclusion in forbidden:
            violations.append(f"{name}: conclusion='{conclusion}' (forbidden by §33.2)")

    if violations:
        print(
            f"CHECK-CONCLUSIONS FAIL: {len(violations)} check(s) reported forbidden conclusion in PR #{pr}:\n  "
            + "\n  ".join(violations),
            file=sys.stderr,
        )
        return 1

    if in_progress:
        print(
            f"CHECK-CONCLUSIONS PENDING: {len(in_progress)} check(s) still in progress on PR #{pr}:\n  "
            + "\n  ".join(in_progress),
            file=sys.stderr,
        )
        return 1

    print(
        f"CHECK-CONCLUSIONS PASS: all {checked_count} check(s) on PR #{pr} concluded with valid, real outcomes; zero skipped or neutral."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
