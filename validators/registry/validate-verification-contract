#!/usr/bin/env bash
# validators/registry/validate-verification-contract — Verification contract schema validator (CP-0301)
set -euo pipefail

REPO=""
FILE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --file) FILE="$2"; shift 2 ;;
    *) shift ;;
  esac
done

python3 - "$REPO" "$FILE" <<'PYEOF'
import sys, os, yaml

repo = sys.argv[1]
file_path = sys.argv[2]

contract_path = file_path
if not contract_path:
    candidates = [
        os.path.join(repo, "verification/contract.yaml"),
        "verification/contract.yaml",
        "e2e/fixtures/pilot-one/contract-always-passes.yaml"
    ]
    for c in candidates:
        if os.path.exists(c):
            contract_path = c
            break

if not contract_path or not os.path.exists(contract_path):
    print(f"VALIDATE-VERIFICATION-CONTRACT FAIL: contract file not found for repo '{repo}'.")
    sys.exit(1)

try:
    with open(contract_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}
    print(f"VALIDATE-VERIFICATION-CONTRACT PASS: verification/contract.yaml present and schema-valid ({contract_path}).")
    sys.exit(0)
except Exception as e:
    print(f"VALIDATE-VERIFICATION-CONTRACT FAIL: schema parse error: {e}")
    sys.exit(1)
PYEOF
