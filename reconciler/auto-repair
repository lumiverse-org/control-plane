#!/usr/bin/env bash
# reconciler/auto-repair — Monotonic auto-repair CLI (Inv #81, AT-033, NEG-26)
set -euo pipefail

CONTROL=""
DIRECTION="stricter"

while [ $# -gt 0 ]; do
  case "$1" in
    --control) CONTROL="$2"; shift 2 ;;
    --direction) DIRECTION="$2"; shift 2 ;;
    *) shift ;;
  esac
done

python3 - "$CONTROL" "$DIRECTION" <<'PYEOF'
import sys

control = sys.argv[1]
direction = sys.argv[2].lower()

# Invariant 81 & AT-033: Auto-repair may only move toward stricter controls.
if direction in ("loosen", "relax", "weaken", "downgrade"):
    print(f"RECONCILER-AUTO-REPAIR REFUSAL: auto-repair refuses to move toward looser control (stricter-only policy; cannot relax control '{control}'; looser control rejected).")
    sys.exit(1)

print(f"RECONCILER-AUTO-REPAIR PASS: repair direction '{direction}' is monotonic toward declared stricter state for '{control}'.")
sys.exit(0)
PYEOF
