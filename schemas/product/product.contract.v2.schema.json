{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/product/product.contract.v2.schema.json",
  "title": "Product Operating Contract (product.yaml) v2",
  "description": "Section 15 (lines 1284-1606). Built incrementally across L1-301..L1-308, one block per task, all edits to this single file. This lane's cluster (L1-301, L1-302 [separate file], L1-303, L1-304, L1-305, L1-306, L1-307) lands the envelope, identity, classification, code/verification/environments/deployment, the infrastructure/dependencies/security/data/observability/ai/business blocks, operations, commitments, and recovery. The conformance-profile rules (L1-308) are later tasks in this same phase and are not yet reflected here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "platform_compatibility",
    "platform_migration",
    "conformance_profile",
    "identity",
    "classification",
    "assignments",
    "escalation",
    "code",
    "verification",
    "environments",
    "deployment",
    "reversibility_default",
    "infrastructure",
    "dependencies",
    "security",
    "ai_runtime_dependency",
    "ai_restrictions",
    "data",
    "observability",
    "automated_containment",
    "business",
    "operations",
    "commitments",
    "recovery"
  ],
  "properties": {
    "contract_version": { "const": 2 },
    "platform_compatibility": {
      "type": "string",
      "enum": ["supported", "transitional", "unsupported"]
    },
    "platform_migration": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_contract_version", "target_workflow_version", "owner", "deadline", "reason"],
          "properties": {
            "target_contract_version": { "type": "integer", "minimum": 1 },
            "target_workflow_version": { "type": "string", "minLength": 1 },
            "owner": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" },
            "deadline": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/isoDate" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "conformance_profile": {
      "type": "string",
      "enum": [
        "service",
        "client-app",
        "library",
        "batch",
        "customer-hosted",
        "white-label",
        "static-site"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "lifecycle", "launch_status", "created"],
      "properties": {
        "id": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" },
        "display_name": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "type": "string",
          "enum": ["active", "maintenance", "paused", "sunset", "archived"]
        },
        "launch_status": {
          "type": "string",
          "enum": ["pre-launch", "launched"]
        },
        "created": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/isoDate" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "reliability_criticality"],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1,
          "description": "Section 15.3: classes are configuration, not hard-coded. Not an enum -- see L1-301 STOP. AT-001, invariant 53."
        },
        "reliability_criticality": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "domain": {
          "oneOf": [
            { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" },
            { "type": "null" }
          ]
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": { "$ref": "https://control-plane.local/schemas/registry/common/assignments.v1.schema.json" }
    },
    "escalation": {
      "type": "string",
      "minLength": 1,
      "description": "Section 10.2: a ROLE token, never a person."
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "default_branch", "gsd_version", "accepts_external_contributions"],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "description": "Invariant 62, AT-010: one product may have many repositories. No maximum -- see L1-303 STOP.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "deploys"],
            "properties": {
              "name": { "type": "string", "pattern": ".+/.+" },
              "role": { "type": "string", "minLength": 1 },
              "deploys": { "type": "boolean" }
            }
          }
        },
        "default_branch": { "type": "string", "minLength": 1 },
        "gsd_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$",
          "description": "Section 15.1: a pinned tag, never latest or next. Invariant 85."
        },
        "accepts_external_contributions": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "manual_uat", "smoke_tests", "performance", "contract_path"],
      "properties": {
        "automated": { "type": "string", "enum": ["required", "optional", "not-applicable"] },
        "manual_uat": { "type": "string", "enum": ["required", "not-applicable"] },
        "smoke_tests": { "type": "string", "enum": ["required", "optional", "not-applicable"] },
        "performance": { "type": "string", "enum": ["required", "optional", "not-applicable"] },
        "contract_path": { "type": "string", "minLength": 1 }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "staging", "production"],
      "properties": {
        "local": { "type": "string", "minLength": 1 },
        "staging": { "type": ["string", "null"] },
        "production": { "type": ["string", "null"] }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "artifact_type",
        "artifact_registry",
        "rollback_supported",
        "rollback_method",
        "progressive_delivery",
        "staged_rollout"
      ],
      "properties": {
        "build": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "artifact_registry": { "type": "string", "minLength": 1 },
        "rollback_supported": { "type": "boolean" },
        "rollback_method": { "type": ["string", "null"] },
        "progressive_delivery": { "type": "string", "enum": ["none", "flag-gated", "staged-rollout"] },
        "staged_rollout": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["stages_pct", "observation_window_hours", "advancer", "crash_free_sessions"],
              "properties": {
                "stages_pct": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "description": "Monotonicity is enforced by rule at L1-308, not by schema."
                },
                "observation_window_hours": { "type": "integer", "minimum": 1 },
                "advancer": { "type": "string", "minLength": 1 },
                "crash_free_sessions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sev2_below_pct", "sev1_below_pct"],
                  "properties": {
                    "sev2_below_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                    "sev1_below_pct": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "reversibility_default": {
      "type": "string",
      "enum": ["fully-reversible", "partially-reversible", "non-reversible"]
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "database",
        "cache",
        "provider",
        "region",
        "provider_outage_behaviour",
        "monthly_budget_band"
      ],
      "properties": {
        "runtime": { "type": ["string", "null"] },
        "database": { "type": ["string", "null"] },
        "cache": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "provider_outage_behaviour": { "type": "string", "minLength": 1 },
        "monthly_budget_band": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "expected", "ceiling"],
          "description": "Invariant 88.",
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "expected": { "type": "number", "minimum": 0 },
            "ceiling": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external", "infrastructure"],
      "properties": {
        "internal": {
          "type": "array",
          "items": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" }
        },
        "external": { "type": "array", "items": { "type": "string" } },
        "infrastructure": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets_location", "scorecard_minimum", "production_db_access"],
      "properties": {
        "secrets_location": { "type": "string", "minLength": 1 },
        "scorecard_minimum": { "type": "number", "minimum": 0, "maximum": 10 },
        "production_db_access": { "type": "string", "minLength": 1 }
      }
    },
    "ai_runtime_dependency": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["providers", "evaluation"],
          "properties": {
            "providers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "evaluation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["suite"],
              "description": "AT-049: a declared ai_runtime_dependency without an evaluation suite fails CI.",
              "properties": {
                "suite": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "ai_restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_processing_permitted", "restricted_paths", "basis"],
      "properties": {
        "ai_processing_permitted": { "type": "boolean" },
        "restricted_paths": { "type": "array", "items": { "type": "string" } },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "retention_days",
            "residency",
            "isolation",
            "deletion_supported",
            "deletion_sla_days",
            "subprocessors"
          ],
          "properties": {
            "classification": {
              "type": "string",
              "enum": ["public", "internal", "customer-data", "customer-pii", "regulated"]
            },
            "retention_days": { "type": "integer", "minimum": 1 },
            "residency": { "type": "string", "minLength": 1 },
            "isolation": {
              "type": "string",
              "enum": ["shared-tenant", "dedicated-tenant", "dedicated-infrastructure"]
            },
            "deletion_supported": { "type": "boolean" },
            "deletion_sla_days": { "type": "integer", "minimum": 1 },
            "regulatory_notification_hours": { "type": "integer", "minimum": 1 },
            "subprocessors": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health_endpoint", "version_endpoint", "metrics", "telemetry_exposure", "alert_channel"],
      "description": "health_endpoint/version_endpoint are nullable -- Section 15.7 exempts client-app, library, batch and static-site from the service interface. The L1-308 conformance rule requires them non-null for `service`.",
      "properties": {
        "health_endpoint": { "type": ["string", "null"] },
        "version_endpoint": { "type": ["string", "null"] },
        "metrics": { "type": ["string", "null"] },
        "telemetry_exposure": { "type": "string", "enum": ["private-authenticated", "public"] },
        "alert_channel": { "type": "string", "minLength": 1 }
      }
    },
    "automated_containment": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "trigger_alert_class", "action", "flag"],
          "properties": {
            "enabled": { "type": "boolean" },
            "trigger_alert_class": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "enum": ["halt-writes", "disable-feature-flag"] },
            "flag": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticality", "active_customers", "revenue_importance"],
      "description": "Section 15.2: classification.reliability_criticality and business.criticality are separately required and never collapsed.",
      "properties": {
        "criticality": { "type": "string", "enum": ["high", "medium", "low"] },
        "active_customers": { "type": "integer", "minimum": 0 },
        "revenue_importance": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_model",
        "coverage_window",
        "detection_expectation",
        "intake_channel",
        "triager",
        "weekend_exception_eligible",
        "primary_responder",
        "backup_responder",
        "critical_incident_response"
      ],
      "description": "Section 15.1 operations block (L1-305). detection_expectation is DERIVED from support_model -- R-PRD-05 (Section 42.2 mapping) fails a declared value differing from the derived one. primary_responder/backup_responder are DERIVED from incident_responder assignments -- R-PRD-15 (Section 15.1). Both rules live in validators/registry/rules/r_prd_05.py, not encoded in the schema itself.",
      "properties": {
        "support_model": { "type": "string", "enum": ["business-hours", "extended", "24x7"] },
        "coverage_window": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["days", "hours", "timezone"],
              "description": "Section 47.9: 'days, hours and timezone'. Presence is required by R-PRD-13 (Section 15.5) when support_model is extended or 24x7 -- not enforced here in the schema.",
              "properties": {
                "days": { "type": "array", "items": { "type": "string" } },
                "hours": { "type": "string", "minLength": 1 },
                "timezone": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/ianaTimezone" }
              }
            }
          ]
        },
        "detection_expectation": {
          "type": "string",
          "enum": ["next-business-morning", "rostered-window", "continuous"]
        },
        "intake_channel": { "type": ["string", "null"] },
        "triager": { "type": ["string", "null"] },
        "weekend_exception_eligible": { "type": "boolean" },
        "primary_responder": {
          "oneOf": [
            { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "backup_responder": {
          "oneOf": [
            { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "critical_incident_response": { "type": "string", "minLength": 1 }
      }
    },
    "commitments": {
      "type": "array",
      "description": "Section 21.1; Section 15.5. May be empty. `customer` is a stable reference -- invariant 111: the mapping from reference to legal entity lives with the customer contact list, never in this repo. R-PRD-06/16/17 live in validators/registry/rules/r_prd_06.py, not encoded here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customer",
          "sla_uptime_pct",
          "measurement_window",
          "support_commitment",
          "breach_notification_hours",
          "service_credit",
          "contract_end",
          "termination_notice_period_days",
          "conflict_check"
        ],
        "properties": {
          "customer": {
            "type": "string",
            "pattern": "^customer-ref-[a-z0-9-]+$",
            "description": "Invariant 111: a stable reference, never a legal name."
          },
          "sla_uptime_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "measurement_window": { "type": "string", "enum": ["monthly", "quarterly"] },
          "support_commitment": { "type": "string", "enum": ["business-hours", "extended", "24x7"] },
          "response_targets": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["sev1_hours", "sev2_hours"],
                "properties": {
                  "sev1_hours": { "type": "number", "minimum": 0 },
                  "sev2_hours": { "type": "number", "minimum": 0 }
                }
              }
            ]
          },
          "breach_notification_hours": { "type": "integer", "minimum": 1 },
          "service_credit": { "type": "string", "enum": ["none", "per-msa", "defined-schedule"] },
          "data_commitments": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["residency"],
                "properties": {
                  "residency": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "contract_end": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/isoDate" },
          "termination_notice_period_days": { "type": "integer", "minimum": 0 },
          "conflict_check": { "type": "string", "enum": ["passed", "waived-with-decision"] }
        }
      }
    },
    "recovery": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backup_frequency",
            "backup_retention_days",
            "encrypted",
            "storage_location",
            "restore_procedure",
            "restore_environment",
            "integrity_check",
            "restore_tested",
            "rpo_minutes",
            "rto_minutes"
          ],
          "description": "Section 15.1 recovery block (L1-307). null is schema-legal for any conformance_profile; Section 15.7 permits it specifically for static-site -- enforcing that it is ONLY legal there is R-PRD-08/L1-308's job, not this schema. restore_tested cadence against classification.reliability_criticality is enforced by R-PRD-07 in validators/registry/rules/r_prd_07.py, not encoded here.",
          "properties": {
            "backup_frequency": { "type": "string", "minLength": 1 },
            "backup_retention_days": { "type": "integer", "minimum": 1 },
            "encrypted": { "type": "boolean" },
            "storage_location": { "type": "string", "minLength": 1 },
            "restore_procedure": { "type": "string", "minLength": 1 },
            "restore_environment": { "type": "string", "minLength": 1 },
            "integrity_check": { "type": "string", "minLength": 1 },
            "restore_tested": { "$ref": "https://control-plane.local/schemas/registry/common/defs.v1.schema.json#/$defs/isoDate" },
            "rpo_minutes": { "type": "integer", "minimum": 0 },
            "rto_minutes": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  },
  "if": {
    "properties": { "platform_compatibility": { "const": "transitional" } },
    "required": ["platform_compatibility"]
  },
  "then": {
    "properties": { "platform_migration": { "type": "object" } },
    "required": ["platform_migration"]
  }
}
