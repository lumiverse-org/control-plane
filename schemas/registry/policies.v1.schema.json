{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:registry:policies:v1",
  "title": "Policies Registry",
  "description": "Governance policies registry (L1-02, FD-096)",
  "type": "object",
  "required": ["id", "name", "enforced_by"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "enforced_by": { "type": "string" },
    "scope": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
